# Copy to .env and fill in. Never commit .env.

CAREHUB_PORT=8040

# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PAPERLESS_SECRET_KEY=

# The public address people use, e.g. https://carehub.example.com.au
PAPERLESS_URL=

# First admin account, created on first start.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# ---- AI model: pick ONE of the two options ----

# Option A: Claude via Anthropic's OpenAI-compatible endpoint (online demo).
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=https://api.anthropic.com/v1/
PAPERLESS_AI_LLM_MODEL=claude-opus-5-5
PAPERLESS_AI_LLM_API_KEY=
# Current Claude models reject the `temperature` setting that llama-index
# always sends; null removes it from the request.
PAPERLESS_AI_LLM_EXTRA_PARAMS='{"temperature": null}'

# Option B: fully in-house on a Mac mini or GPU server running Ollama.
# Nothing leaves the building. Example for a Mac mini with 48 GB or more:
# PAPERLESS_AI_LLM_BACKEND=ollama
# PAPERLESS_AI_LLM_ENDPOINT=http://host.docker.internal:11434
# PAPERLESS_AI_LLM_MODEL=qwen3:32b
# PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
# PAPERLESS_AI_LLM_EMBEDDING_MODEL=embeddinggemma

# Set to 1 once the first document has been indexed (model is cached).
HF_HUB_OFFLINE=0
