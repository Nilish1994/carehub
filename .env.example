# Copy to .env and fill in. Never commit .env.
# Check it with: python tools/check_config.py

# Host port the web app listens on (127.0.0.1 only). If you change it, point
# your reverse proxy (proxy_pass) at the same port. The demo loader uses it too.
CAREHUB_PORT=8040

# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PAPERLESS_SECRET_KEY=

# The public address people use, e.g. https://carehub.example.com.au
PAPERLESS_URL=

# First admin account, created on first start.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# ---- Demo accounts (only needed to load the fictional demo) ----
# Passwords for demo.manager, demo.admin and demo.carer. The demo loader stops
# before changing anything if any of these three is empty. Note: docker compose
# passes every .env value into the web container, these included.
DEMO_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_CARER_PASSWORD=
# Optional extra account test.user (member of every group).
# DEMO_TEST_PASSWORD=
# Demo loader target. Defaults to http://127.0.0.1:${CAREHUB_PORT}.
# CAREHUB_API=http://127.0.0.1:8040

# ---- AI model: pick ONE of the two options (comment out the other) ----
# Settings saved later on the app's Configuration page override these.
# After changing the embedding backend or model, rebuild the AI index.

# Option A: Claude via Anthropic's OpenAI-compatible endpoint (online demo).
# The text of document passages relevant to a question is sent to Anthropic.
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=https://api.anthropic.com/v1/
PAPERLESS_AI_LLM_MODEL=claude-opus-5-5
PAPERLESS_AI_LLM_API_KEY=
# Current Claude models reject the `temperature` setting that llama-index
# always sends; null removes it from the request.
PAPERLESS_AI_LLM_EXTRA_PARAMS='{"temperature": null}'
# Embeddings computed on this server's CPU (model downloaded once from
# Hugging Face, then cached; see HF_HUB_OFFLINE below).
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Option B: in-house, on a machine running Ollama (on the Docker host here).
# Chat and embeddings both go to the Ollama endpoint. Model choice and the
# memory it needs are not benchmarked for this project; size them yourself.
# PAPERLESS_AI_LLM_BACKEND=ollama
# PAPERLESS_AI_LLM_ENDPOINT=http://host.docker.internal:11434
# PAPERLESS_AI_LLM_MODEL=qwen3:32b
# PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
# PAPERLESS_AI_LLM_EMBEDDING_MODEL=embeddinggemma

# Set to 1 once the first document has been indexed with the Hugging Face
# embedding model (it is then cached). Not used by Option B.
HF_HUB_OFFLINE=0
